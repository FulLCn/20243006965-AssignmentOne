<?xml version="1.0" encoding="utf-8"?>
<!--
    Part F: layout of DetailActivity.
    Topic image on top, title underneath, scrollable body text at the bottom.
    All heights use weights, so the screen adapts to any size and orientation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Topic image (replaced at run time in Part H) -->
    <ImageView
        android:id="@+id/ivDetailImage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="@color/light_green"
        android:contentDescription="@string/detail_image_placeholder"
        android:padding="24dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_facilities" />

    <!-- Topic title (placeholder text until Java replaces it) -->
    <TextView
        android:id="@+id/tvDetailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/detail_title_placeholder"
        android:textColor="@color/green"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Scrollable topic body (placeholder text until Java replaces it) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3">

        <TextView
            android:id="@+id/tvDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:text="@string/detail_content_placeholder"
            android:textSize="16sp" />
    </ScrollView>
</LinearLayout>
