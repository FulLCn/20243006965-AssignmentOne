<?xml version="1.0" encoding="utf-8"?>
<!--
    Part C: portrait layout of the CampusLife main screen.
    A green banner on top and the four topic buttons in a 2 x 2 grid below it.
    Everything is sized with weights, so the layout stays responsive on any screen;
    the only fixed size is the banner title at 40sp, which the specification allows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Banner -->
    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/green"
        android:gravity="center"
        android:text="@string/banner_title"
        android:textColor="@color/white"
        android:textSize="40sp"
        android:textStyle="bold" />

    <!-- Lower half: two rows, each row holding two buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnFacilities"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/btn_selector"
                android:backgroundTint="@null"
                android:contentDescription="@string/cd_facilities"
                android:padding="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_facilities" />

            <ImageButton
                android:id="@+id/btnEvents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/btn_selector"
                android:backgroundTint="@null"
                android:contentDescription="@string/cd_events"
                android:padding="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_events" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnClubs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/btn_selector"
                android:backgroundTint="@null"
                android:contentDescription="@string/cd_clubs"
                android:padding="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_clubs" />

            <ImageButton
                android:id="@+id/btnSupport"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="8dp"
                android:background="@drawable/btn_selector"
                android:backgroundTint="@null"
                android:contentDescription="@string/cd_support"
                android:padding="24dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_support" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
